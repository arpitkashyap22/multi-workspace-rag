# ==============================================================================
# Multi-Workspace Document Assistant - Environment Variables Template
# Copy this file to .env (for local development) or populate .streamlit/secrets.toml
# NEVER commit real credentials or keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Neon Serverless Postgres with pgvector)
# ------------------------------------------------------------------------------
# Direct connection URL (used for migrations and DDL)
DATABASE_URL="postgresql://neondb_owner:<password>@<ep-identifier>.c-4.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Pooled connection URL (recommended for high-concurrency Streamlit cloud runners)
DATABASE_URL_POOLED="postgresql://neondb_owner:<password>@<ep-identifier>-pooler.c-4.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 2. Neon Auth (REST API for User Authentication & Workspace Provisioning)
# ------------------------------------------------------------------------------
NEON_AUTH_BASE_URL="https://<ep-identifier>.neonauth.c-4.<region>.aws.neon.tech/neondb/auth"

# ------------------------------------------------------------------------------
# 3. Neon Object Storage (S3-Compatible Raw Document Storage)
# ------------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3="https://<storage-identifier>.storage.c-4.<region>.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_your_access_key_id_here"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_access_key_here"
AWS_REGION="us-east-1"
S3_BUCKET="uploads"

# ------------------------------------------------------------------------------
# 4. Neon AI Gateway (Optional: Model Proxy / OpenAI-Compatible Routing)
# ------------------------------------------------------------------------------
NEON_AI_GATEWAY_BASE_URL="https://<gateway-identifier>-api.ai.c-4.<region>.aws.neon.tech"
NEON_AI_GATEWAY_TOKEN="nt_live_your_ai_gateway_token_here"

# ------------------------------------------------------------------------------
# 5. Google Gemini API (LLM Conversational Agent & Vector Embeddings)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# ------------------------------------------------------------------------------
# 6. External Notification Webhooks (Tool Calling Integrations)
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/<your_webhook_id>/<your_webhook_token>"
